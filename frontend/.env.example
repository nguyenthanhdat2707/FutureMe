# Environment variables for Future Me Frontend

# API Base URL (default: http://localhost:3000/api)
VITE_API_BASE_URL=http://localhost:3000/api

# Authentication Mode (local, cognito)
# Use 'local' for development, 'cognito' for production
VITE_AUTH_MODE=local

# Cognito Configuration (required if VITE_AUTH_MODE=cognito)
# These are public identifiers for your Cognito User Pool, not secrets.
VITE_COGNITO_REGION=ap-southeast-1
VITE_COGNITO_USER_POOL_ID=ap-southeast-1_QPUDNfHPC
VITE_COGNITO_USER_POOL_CLIENT_ID=6bmk4mat408ohki5t9k1a7n270
